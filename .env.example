# Copy to .env and uncomment what you want to change. Every variable below is
# optional: the value shown is the built-in default, so the server runs with no
# .env file at all.
#
# Pass the file explicitly: ./app -env /path/to/.env
# There is no implicit lookup — under stdio the working directory is chosen by
# the MCP client, so a relative default would be unpredictable.

# --- MCP server ---
# MCP_TRANSPORT=stdio          # stdio | http
# MCP_NAME=mcp-retrieval
# MCP_VERSION=0.1.0
# MCP_PATH=/mcp                # used only when MCP_TRANSPORT=http

# --- HTTP server (used only when MCP_TRANSPORT=http) ---
# SERVER_PORT=8080
# SERVER_READ_TIMEOUT=60s
# SERVER_WRITE_TIMEOUT=60s

# --- Logging ---
# LOG_MODE=local               # local (text, debug) | prod (json, info)

# --- HTTP client ---
# MAX_IDLE_CONNS_PER_HOST=100

# --- Limits ---
# MAX_QUERIES=10
# DEFAULT_RESULTS=5
# MAX_RESULTS=20
# DEFAULT_TIMEOUT_MS=5000
# MIN_TIMEOUT_MS=1000
# MAX_TIMEOUT_MS=10000
# DEFAULT_IMAGES=5
# MAX_IMAGES=10
# DEFAULT_DOCUMENT_CHARS=20000
# MAX_DOCUMENT_CHARS=20000

# --- Outbound proxy (optional; set all five or none) ---
# PROXY_SCHEME=http
# PROXY_HOST=
# PROXY_PORT=
# PROXY_LOGIN=
# PROXY_PASSWORD=
